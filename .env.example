# ==============================================================================
# Journey Endurance Strength - Environment Variables Template
# ==============================================================================

# Security
# Set your production SECRET_KEY in Railway or your local .env
SECRET_KEY=KA6xsq5J7cEZbaXR80ezbcbJbcrS0P8xVg6sXjHZzlrO8wHZWd
DJANGO_DEBUG=False

# Site & Domain
# When deployed on Railway, set SITE_URL to: https://${{RAILWAY_PUBLIC_DOMAIN}}
SITE_URL=http://localhost:8000
ALLOWED_HOSTS=*

# Database
# When running on Railway with PostgreSQL plugin, Railway provides DATABASE_URL automatically.
# Otherwise, default is:
# DJANGO_DB_DATABASE=/home/journey/db/database.sqlite

# Media & Static Storage Mounts
DJANGO_MEDIA_ROOT=/home/journey/media
DJANGO_STATIC_ROOT=/home/journey/static

# Startup & Migrations
DJANGO_PERFORM_MIGRATIONS=True
WGER_USE_GUNICORN=True

# Application Branding & Email
FROM_EMAIL=Journey Endurance Strength <noreply@journeyendurance.com>
ALLOW_REGISTRATION=True
WGER_SHOW_APP_STORE_LINKS=False

# Optional: Email (SMTP) Settings
# ENABLE_EMAIL=False
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=your-api-key
# EMAIL_USE_TLS=True

# Optional: JWT Keys for API Authentication
# Run `python manage.py generate-jwt-keys` in the container to generate
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
